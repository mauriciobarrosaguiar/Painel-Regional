{
  "name": "painel-regional",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:base": "node scripts/preparar-base-interna.mjs",
    "build": "npm run prepare:base && tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name painel-regional",
    "db:migrate": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.0.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Banco SQL D1 do Painel Regional, com Regionais, Distritais, Consultores, usuários e resultados."
      }
    }
  }
}
